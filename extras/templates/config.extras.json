{
  "thresholds": {},
  "windows": [],
  "stale_after_minutes": 30,
  "delegation": {
    "enabled": true,
    "max_parallel": 3,
    "model_tiers": {
      "light": "",
      "standard": "",
      "strong": ""
    }
  },
  "relay": {
    "enabled": false,
    "max_sessions": 6,
    "run_timeout_minutes": 120,
    "stall_limit": 2,
    "models": [
      {
        "name": "claude-code",
        "tool": "claude-code",
        "priority": 1,
        "enabled": true,
        "command": [
          "claude",
          "-p",
          "{prompt}",
          "--allowedTools",
          "Read,Edit,Write,Glob,Grep,Bash(git:*),Bash(python3 .continuity/scripts/quota_check.py:*),Bash(date:*)"
        ]
      },
      {
        "name": "codex",
        "tool": "codex",
        "priority": 2,
        "enabled": true,
        "command": [
          "codex",
          "exec",
          "--sandbox",
          "workspace-write",
          "{prompt}"
        ]
      },
      {
        "name": "antigravity",
        "tool": "antigravity",
        "priority": 3,
        "enabled": true,
        "command": [
          "agy",
          "-p",
          "{prompt}",
          "--print-timeout",
          "60m"
        ]
      }
    ]
  }
}
